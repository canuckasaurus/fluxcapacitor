{
  "uid": "fluxcapacitor",
  "title": "FluxCapacitor",
  "tags": ["fluxcapacitor"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests / s (by status)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(flux_web_prom_ex_phoenix_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP request duration p50 / p95 (ms)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(flux_web_prom_ex_phoenix_http_request_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(flux_web_prom_ex_phoenix_http_request_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Workflow runs / h (by status)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(flux_workflow_runs_total[1h]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Workflow run duration p95 (ms)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(flux_workflow_run_duration_milliseconds_bucket[15m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Ecto query total time p95 (ms)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(flux_web_prom_ex_ecto_repo_query_total_time_milliseconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Oban queue length",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (flux_web_prom_ex_oban_queue_length_count)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "BEAM memory (bytes)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "flux_web_prom_ex_beam_memory_allocated_bytes",
          "legendFormat": "allocated"
        },
        {
          "refId": "B",
          "expr": "flux_web_prom_ex_beam_memory_processes_total_bytes",
          "legendFormat": "processes"
        },
        {
          "refId": "C",
          "expr": "flux_web_prom_ex_beam_memory_ets_total_bytes",
          "legendFormat": "ets"
        },
        {
          "refId": "D",
          "expr": "flux_web_prom_ex_beam_memory_binary_total_bytes",
          "legendFormat": "binary"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "BEAM processes / run queue",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "flux_web_prom_ex_beam_stats_process_count",
          "legendFormat": "processes"
        },
        {
          "refId": "B",
          "expr": "flux_web_prom_ex_beam_stats_run_queue_count",
          "legendFormat": "run queue"
        }
      ]
    }
  ]
}
