<Layouts.flash_group flash={@flash} />
<div class="min-h-screen bg-base-100">
  <div class="bttf-hero">
    <div class="bttf-stars"></div>

    <header class="navbar px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="flex-1">
        <a href="/" class="flex w-fit items-center gap-2">
          <.icon name="hero-bolt-solid" class="size-7 flux-bolt" />
          <span class="text-xl flux-wordmark">FluxCapacitor</span>
        </a>
      </div>
      <div class="flex-none">
        <ul class="flex px-1 space-x-2 items-center">
          <li>
            <a href={FluxWeb.docs_url()} target="_blank" class="btn btn-ghost text-current">
              {gettext("Docs")}
            </a>
          </li>
          <li>
            <.link navigate={~p"/accounts/log-in"} class="btn btn-ghost text-current">
              {gettext("Log in")}
            </.link>
          </li>
          <li>
            <.link navigate={~p"/accounts/register"} class="btn btn-primary">
              Get started <span aria-hidden="true">&rarr;</span>
            </.link>
          </li>
        </ul>
      </div>
    </header>

    <section class="px-4 pt-16 pb-36 sm:px-6 lg:px-8 text-center relative z-10">
      <div class="mx-auto max-w-3xl space-y-8">
        <h1 class="bttf-title text-6xl sm:text-8xl" aria-label="FluxCapacitor">
          <span class="bttf-title-flux">Flux</span>
          <span class="bttf-title-capacitor">Capacitor</span>
        </h1>
        <div class="bttf-trails mx-auto max-w-md" aria-hidden="true"></div>
        <p class="text-lg sm:text-xl font-medium tracking-wide">
          The AI workflow platform your whole team can run.
        </p>
        <p class="text-sm italic opacity-60">Where we're going, we don't need boilerplate.</p>

        <div class="circuit-panel mx-auto max-w-md p-4 text-left space-y-2 relative z-10">
          <div class="flex items-baseline justify-between gap-4">
            <span class="stat-title">Destination time</span>
            <span class="circuit-value circuit-red text-lg">PRODUCTION</span>
          </div>
          <div class="flex items-baseline justify-between gap-4">
            <span class="stat-title">Present time</span>
            <span class="circuit-value circuit-green text-lg">PROTOTYPE</span>
          </div>
          <div class="flex items-baseline justify-between gap-4">
            <span class="stat-title">Last time departed</span>
            <span class="circuit-value circuit-amber text-lg">BOILERPLATE</span>
          </div>
        </div>

        <div class="flex flex-wrap justify-center gap-3">
          <.link navigate={~p"/accounts/register"} class="btn btn-primary btn-lg">
            <.icon name="hero-bolt-solid" class="size-5" /> Get to 88&nbsp;mph
          </.link>
          <.link navigate={~p"/accounts/log-in"} class="btn btn-lg btn-neon">
            Log in yesterday <span aria-hidden="true">❯</span>
          </.link>
        </div>
      </div>
      <div class="bttf-grid" aria-hidden="true"></div>
    </section>
  </div>

  <main>
    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center space-y-3">
        <h2 class="text-2xl font-bold">1.21 gigawatts of workflow</h2>
        <p class="text-lg opacity-80">
          FluxCapacitor is your self-hosted platform for creating <b>Fluxes</b> — AI workflows
          that connect language models, your knowledge bases, and your tools — then publishing
          them as apps and APIs your organization can use safely.
        </p>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 lg:px-8 bg-base-200">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-2xl font-bold text-center mb-10">How it works</h2>
        <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <li class="card bg-base-100 p-6 space-y-2">
            <span class="badge badge-primary">1</span>
            <h3 class="font-semibold">Create your workspace</h3>
            <p class="text-sm opacity-75">
              Register, then create a workspace for your team. Invite teammates as admins,
              editors, or viewers — everyone works in the same place with the right permissions.
            </p>
          </li>
          <li class="card bg-base-100 p-6 space-y-2">
            <span class="badge badge-primary">2</span>
            <h3 class="font-semibold">Connect models &amp; knowledge</h3>
            <p class="text-sm opacity-75">
              Add credentials for your AI model providers and upload documents into knowledge
              bases so Fluxes can ground their answers in your organization's content.
            </p>
          </li>
          <li class="card bg-base-100 p-6 space-y-2">
            <span class="badge badge-primary">3</span>
            <h3 class="font-semibold">Build Fluxes visually</h3>
            <p class="text-sm opacity-75">
              Open the Flux Creator and compose workflows on a visual canvas: prompts, branching
              logic, knowledge retrieval, tools, and human-in-the-loop steps — no glue code.
            </p>
          </li>
          <li class="card bg-base-100 p-6 space-y-2">
            <span class="badge badge-primary">4</span>
            <h3 class="font-semibold">Publish &amp; share</h3>
            <p class="text-sm opacity-75">
              Publish a Flux as a chat app for your team or call it through the API. Versioning
              keeps drafts separate from what's live.
            </p>
          </li>
        </ol>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-2xl font-bold text-center mb-10">What's inside</h2>
        <div class="grid gap-6 sm:grid-cols-2">
          <div class="card border border-base-200 p-6 space-y-2">
            <.icon name="hero-squares-2x2" class="size-6 text-primary" />
            <h3 class="font-semibold">Flux Creator</h3>
            <p class="text-sm opacity-75">
              A visual canvas with 25 node types — LLMs, agents with human tool approval,
              branching, iteration over sub-fluxes (pinnable to a version), code in a sandbox,
              document assembly. Versions diff structurally, A/B splits route live traffic,
              an AI helper drafts and revises graphs, and Ctrl+K jumps anywhere.
            </p>
          </div>
          <div class="card border border-base-200 p-6 space-y-2">
            <.icon name="hero-chat-bubble-left-right" class="size-6 text-primary" />
            <h3 class="font-semibold">Apps &amp; published sites</h3>
            <p class="text-sm opacity-75">
              Chat, completion, and chatflow apps with markdown-rendered streaming replies,
              image uploads for vision models, regenerate, follow-up suggestions, and
              conversation history — published to a public URL, embedded as an iframe or
              chat bubble, or driven through the token-scoped service API.
            </p>
          </div>
          <div class="card border border-base-200 p-6 space-y-2">
            <.icon name="hero-book-open" class="size-6 text-primary" />
            <h3 class="font-semibold">Knowledge</h3>
            <p class="text-sm opacity-75">
              Hybrid retrieval — vectors, full-text, and entity mentions fused by rank — with
              citations on every answer. Ingest uploads, synced datasources, or a URL (crawl
              its links in one action); back it with pgvector or ArangoDB; measure changes
              with retrieval evals before they hit production.
            </p>
          </div>
          <div class="card border border-base-200 p-6 space-y-2">
            <.icon name="hero-check-badge" class="size-6 text-primary" />
            <h3 class="font-semibold">Quality loop</h3>
            <p class="text-sm opacity-75">
              Eval sets with exact, regex, and LLM-judge graders gate publishes and re-score on
              a schedule. Native labeling runs consensus voting with gold standards, and a
              model registry versions trained artifacts — label, train, and serve without
              leaving the platform.
            </p>
          </div>
          <div class="card border border-base-200 p-6 space-y-2">
            <.icon name="hero-play-circle" class="size-6 text-primary" />
            <h3 class="font-semibold">Operations</h3>
            <p class="text-sm opacity-75">
              Every run drills into a per-node waterfall with token attribution — compare any
              two side by side. Batches over CSV, monthly budgets, concurrency caps, an LLM
              cache, regex guardrails, and signed webhooks with a delivery log keep production
              honest.
            </p>
          </div>
          <div class="card border border-base-200 p-6 space-y-2">
            <.icon name="hero-chart-bar" class="size-6 text-primary" />
            <h3 class="font-semibold">Observability</h3>
            <p class="text-sm opacity-75">
              Prometheus metrics — HTTP, runs, tokens, estimated cost — with a provisioned
              Grafana dashboard one compose profile away. OpenTelemetry traces and structured
              logs are an env var each.
            </p>
          </div>
          <div class="card border border-base-200 p-6 space-y-2">
            <.icon name="hero-puzzle-piece" class="size-6 text-primary" />
            <h3 class="font-semibold">Plugins</h3>
            <p class="text-sm opacity-75">
              OpenAI, Anthropic, Gemini, Azure OpenAI, Amazon Bedrock, or any OpenAI-compatible
              endpoint — plus tool, datasource, trigger, and endpoint plugins from one SDK.
              Installed per workspace, credentials encrypted, validated on save.
            </p>
          </div>
          <div class="card border border-base-200 p-6 space-y-2">
            <.icon name="hero-user-group" class="size-6 text-primary" />
            <h3 class="font-semibold">Teams &amp; enterprise</h3>
            <p class="text-sm opacity-75">
              Workspaces with role-based access control (built-in and custom roles), OIDC single
              sign-on, SCIM provisioning, an append-only audit trail, full export/import
              archives, and a console that speaks English, French, and Spanish.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="px-4 py-16 sm:px-6 lg:px-8 bg-base-200 text-center">
      <div class="mx-auto max-w-2xl space-y-4">
        <h2 class="text-2xl font-bold">Ready to build your first Flux?</h2>
        <p class="opacity-75">
          Create an account, set up your workspace, and invite your team.
          Roads not required.
        </p>
        <.link navigate={~p"/accounts/register"} class="btn btn-primary btn-lg">
          Get started free <span aria-hidden="true">❯</span>
        </.link>
      </div>
    </section>
  </main>

  <footer class="px-4 py-8 text-center text-sm opacity-70 space-y-3">
    <div><span class="outatime-plate">Outatime</span></div>
    <div>
      <span class="flux-wordmark not-italic">FluxCapacitor</span>
      ⚡ self-hosted AI workflow platform ·
      <a href={FluxWeb.docs_url()} target="_blank" class="link">docs</a>
    </div>
  </footer>
</div>
